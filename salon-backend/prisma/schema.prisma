generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  phone        String?
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[] @relation("CustomerAppointments")
  reviews      Review[]
  salonsOwned  Salon[]       @relation("SalonOwner")
  staffProfile Staff?

  @@map("users")
}

model Salon {
  id           String        @id @default(uuid())
  ownerId      String
  name         String
  description  String?
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  phone        String?
  imageUrl     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  reviews      Review[]
  owner        User          @relation("SalonOwner", fields: [ownerId], references: [id])
  services     Service[]
  staff        Staff[]

  @@map("salons")
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  services Service[]

  @@map("service_categories")
}

model Service {
  id              String           @id @default(uuid())
  salonId         String
  categoryId      String?
  name            String
  description     String?
  durationMinutes Int
  price           Decimal          @db.Decimal(10, 2)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  appointments    Appointment[]
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff           StaffService[]

  @@map("services")
}

model Staff {
  id           String         @id @default(uuid())
  userId       String         @unique
  salonId      String
  bio          String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  appointments Appointment[]
  leaves       Leave[]
  salon        Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  services     StaffService[]
  workingHours WorkingHour[]

  @@map("staff")
}

model StaffService {
  staffId   String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model WorkingHour {
  id        String @id @default(uuid())
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("working_hours")
}

model Leave {
  id        String   @id @default(uuid())
  staffId   String
  startDate DateTime
  endDate   DateTime
  reason    String?
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model Appointment {
  id         String            @id @default(uuid())
  customerId String
  salonId    String
  staffId    String
  serviceId  String
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(BOOKED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  customer   User              @relation("CustomerAppointments", fields: [customerId], references: [id])
  salon      Salon             @relation(fields: [salonId], references: [id])
  service    Service           @relation(fields: [serviceId], references: [id])
  staff      Staff             @relation(fields: [staffId], references: [id])
  review     Review?

  @@index([staffId, startTime, endTime])
  @@map("appointments")
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  customerId    String
  salonId       String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  customer      User        @relation(fields: [customerId], references: [id])
  salon         Salon       @relation(fields: [salonId], references: [id])

  @@map("reviews")
}

enum Role {
  CUSTOMER
  STAFF
  SALON_OWNER
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}
